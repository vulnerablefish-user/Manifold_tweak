+              e.used && e.by_dev && e.peer == 2 && e.conf[0] == 0x21 && e.conf[3] == 35);
+        k = bv_acp(c_set, 14, &e, o, &ev);
+        check("... again: SEP_IN_USE", k == 4 && o[3] == 0x13);
+        k = bv_acp(c_disc, 2, &e, o, &ev);
+        check("... DISCOVER now: in use", k == 4 && o[2] == 6);
+        k = bv_acp(c_open, 3, &e, o, &ev);
+        check("... OPEN: accepted", k == 2 && o[0] == 0x62 && ev == BV_EV_OPEN && e.opened);
+        k = bv_acp(c_start, 3, &e, o, &ev);
+        check("... START before the media channel: BAD_STATE", k == 4 && o[3] == 0x31 && !e.started);
+        e.media = 1;
+        k = bv_acp(c_start, 3, &e, o, &ev);
+        check("... START with it: accepted", k == 2 && o[0] == 0x72 && ev == BV_EV_START && e.started);
+        k = bv_acp(c_delay, 5, &e, o, &ev);
+        check("... DELAY_REPORT: accepted", k == 2 && o[0] == 0xB2 && ev == BV_EV_NONE);
+        k = bv_acp(c_susp, 3, &e, o, &ev);
+        check("... SUSPEND: accepted", k == 2 && o[0] == 0x82 && ev == BV_EV_SUSPEND && !e.started);
+        k = bv_acp(c_sec, 3, &e, o, &ev);
+        check("... SECURITY_CONTROL: NOT_SUPPORTED_COMMAND", k == 3 && o[0] == 0xC3 && o[2] == 0x19);
+        k = bv_acp(c_close, 3, &e, o, &ev);
+        check("... CLOSE: accepted, free", k == 2 && o[0] == 0x92 && ev == BV_EV_CLOSE && !e.used && !e.opened);
+        k = bv_acp(c_abort, 3, &e, o, &ev);
+        check("... ABORT: always accepted", k == 2 && o[0] == 0xA2);
+        k = bv_acp(r_caps, 12, &e, o, &ev);
+        check("... an accept is not a command: no answer", k == 0);
+    }
     printf(fails ? "bt_avdtp_test: %d FAILED\n" : "bt_avdtp_test: all ok\n", fails);
     return fails != 0;
 }
